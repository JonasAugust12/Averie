{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"],
            "@actions/*": ["./src/actions/*"],
            "@components/*": ["./src/components/*"],
            "@hooks/*": ["./src/hooks/*"],
            "@i18n/*": ["./src/i18n/*"],
            "@libs/*": ["./src/libs/*"],
            "@guard/*": ["./src/guard/*"],
            "@server/*": ["./src/server/*"],
            "@mappers": ["./src/mappers"],
            "@mappers/*": ["./src/mappers/*"],
            "@messages/*": ["./messages/*"],
            "@models/*": ["./src/models/*"],
            "@openapi/*": ["./src/openapi/*"],
            "@providers/*": ["./src/providers/*"],
            "@services/*": ["./src/services/*"],
            "@stores/*": ["./src/stores/*"],
            "@typings/*": ["./src/types/*"],
            "@utils/*": ["./src/utils/*"],
            "@validations/*": ["./src/validations/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.d.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ],
    "exclude": ["node_modules"]
}

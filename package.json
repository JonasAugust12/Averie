{
    "name": "averie",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "pnpm openapi:gen && next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "db:check": "node --env-file=.env.local scripts/check-mongodb.mjs",
        "db:diagnose": "node --env-file=.env.local scripts/diagnose-mongodb.mjs",
        "db:seed": "node --env-file=.env.local scripts/seed-salon.mjs",
        "openapi:gen": "openapi-gen generate",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/react": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "@hookform/resolvers": "^5.7.1",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.0",
        "@tanstack/react-query": "^5.90.12",
        "@tanstack/react-query-devtools": "^5.91.1",
        "axios": "^1.13.2",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.10.0",
        "clsx": "^2.1.1",
        "disable-devtool": "^0.3.9",
        "framer-motion": "^13.1.0",
        "lucide-react": "^0.556.0",
        "mongoose": "^8.19.1",
        "next": "^15.5.4",
        "next-auth": "5.0.0-beta.32",
        "next-intl": "^4.4.0",
        "react": "^19.2.0",
        "react-colorful": "^5.8.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.85.0",
        "react-toastify": "^11.1.0",
        "resend": "^6.25.0",
        "tailwind-merge": "^3.4.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.2.0",
        "@commitlint/config-conventional": "^20.2.0",
        "@eslint/eslintrc": "^3.3.6",
        "@scalar/nextjs-api-reference": "^0.11.14",
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^3.0.0",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "^15.5.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "next-openapi-gen": "^1.7.3",
        "prettier": "^3.7.4",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "@swc/core",
            "sharp",
            "unrs-resolver"
        ]
    }
}

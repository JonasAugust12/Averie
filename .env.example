# =============================================================================
# Averie — Environment variables
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# On Vercel: Project Settings → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public site URL (used by axios baseURL if you call absolute URLs).
# Local:  http://localhost:3000
# Prod:   https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Minimum route transition loading overlay (milliseconds). Waits for navigation to finish;
# if the network is fast, keeps the overlay at least this long. 0 = disabled.
NEXT_PUBLIC_ROUTE_LOADING_MIN_MS=1200

# -----------------------------------------------------------------------------
# Auth.js (next-auth v5)
# -----------------------------------------------------------------------------
# Generate a secret:
#   openssl rand -base64 32
# Or:
#   pnpm exec auth secret
AUTH_SECRET=replace-with-a-long-random-string
# Optional; defaults from request host when trustHost is true
AUTH_URL=http://localhost:3000

# Session cookie lifetime in seconds (persisted across browser restarts until expiry).
# Default when unset or invalid: 2592000 (30 days).
# Examples: 86400 = 1 day, 604800 = 7 days, 2592000 = 30 days
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# -----------------------------------------------------------------------------
# MongoDB Atlas (server-only — NEVER prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Database Access → Add user (username + password)
# 3. Network Access → Add IP Address → "Allow Access from Anywhere" (0.0.0.0/0)
#    (Required for Vercel serverless IPs which change; tighten later if needed)
# 4. Clusters → Connect → Drivers → copy the SRV connection string
#
# Example (Atlas Connect → Drivers → SRV):
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/averie?retryWrites=true&w=majority
#
# Optional split vars (used by scripts/diagnose-mongodb.mjs):
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
#
# Windows: if Node fails with querySrv ECONNREFUSED but nslookup works, set public DNS:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
#
# Fallback if SRV/DNS still fails — directConnection to primary shard only (not secondary):
#   mongodb://USER:PASSWORD@ac-XXXX-shard-00-01.yyyyy.mongodb.net:27017/averie?ssl=true&directConnection=true&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/averie?retryWrites=true&w=majority

# Optional: set to "1" to log mongoose queries in development
# MONGODB_DEBUG=0

# -----------------------------------------------------------------------------
# API documentation (dev only)
# -----------------------------------------------------------------------------
# Set to "1" to enable Scalar docs at /api/docs and spec at /api/openapi.json
# Leave unset or "0" in production
ENABLE_API_DOCS=0

# -----------------------------------------------------------------------------
# Security (production)
# -----------------------------------------------------------------------------
# Build-time: emit browser source maps on production builds (for Sentry etc.).
# Leave unset or "false" in production — applies at `pnpm build`, not runtime.
# PRODUCTION_BROWSER_SOURCE_MAPS=false

# Runtime (client): redirect when DevTools is detected. Production only.
# NEXT_PUBLIC_ENABLE_DEVTOOLS_GUARD=false
# NEXT_PUBLIC_DEVTOOLS_REDIRECT_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

#Cloudinary
# Cloudinary (promotion image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Copy to backend.hcl and fill in, then:
#     terraform init -backend-config=backend.hcl
#
# Bizfly Simple Storage is S3-compatible. Create the bucket first
# (console: Simple Storage -> Create bucket, location hcm, ACL private)
# and an Access Key / Secret Key at
# https://manage.bizflycloud.vn/account/security
#
# Export the keys before running terraform:
#     export AWS_ACCESS_KEY_ID=<simple-storage-access-key>
#     export AWS_SECRET_ACCESS_KEY=<simple-storage-secret-key>

bucket = "averie-terraform-state"
region = "hcm"

endpoints = {
  s3 = "https://hcm.ss.bfcplatform.vn"
}

#!/bin/bash
# Bizfly user_data is executed as a shell script at first boot — not as cloud-config.
# This script is the source of truth for the deploy key in authorized_keys.
set -euxo pipefail
exec >> /var/log/averie-bootstrap.log 2>&1
echo "=== averie bootstrap started $(date -Is) ==="

install -d -m 700 /root/.ssh
AUTH=/root/.ssh/authorized_keys
touch "$AUTH"
chmod 600 "$AUTH"

DEPLOY_KEY=${ssh_public_key_json}
if ! grep -qxF "$DEPLOY_KEY" "$AUTH" 2>/dev/null; then
  echo "$DEPLOY_KEY" >> "$AUTH"
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y python3 python3-pip ca-certificates curl gnupg

timedatectl set-timezone Asia/Ho_Chi_Minh 2>/dev/null || true

cat > /etc/sysctl.d/99-averie.conf <<'SYSCTL'
net.core.somaxconn = 1024
vm.overcommit_memory = 1
SYSCTL
sysctl --system 2>/dev/null || true

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -qxF '/swapfile none swap sw 0 0' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

echo "=== averie bootstrap finished $(date -Is) ==="

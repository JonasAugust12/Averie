{% set vhosts = [app_vhost] + (extra_vhosts | default([])) -%}
# Managed by Ansible - do not edit by hand.
user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile           on;
    tcp_nopush         on;
    keepalive_timeout  65;
    server_tokens      off;

    # Next.js server actions accept up to 6 MB (promotion image uploads).
    client_max_body_size 12m;

    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_types        text/plain text/css application/json application/javascript
                      application/x-javascript text/xml application/xml image/svg+xml;

    # WebSocket / HMR upgrade handling
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Docker's embedded DNS, so a restarting app container does not take Nginx
    # down at startup.
    resolver 127.0.0.11 valid=30s;

    # Reject unknown hostnames and raw-IP probes.
    server {
        listen 80 default_server;
        server_name _;
        return 444;
    }

{%- if enable_tls %}

    server {
        listen 443 ssl default_server;
        http2 on;
        server_name _;
        ssl_certificate     /etc/letsencrypt/live/{{ app_vhost }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ app_vhost }}/privkey.pem;
        return 444;
    }
{%- endif %}
{% for vhost in vhosts %}
    # ---------------------------------------------------------------- {{ vhost }}
    server {
        listen 80;
        server_name {{ vhost }};

        # ACME http-01 challenge, served straight off disk.
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }
{%- if enable_tls %}

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name {{ vhost }};

        ssl_certificate     /etc/letsencrypt/live/{{ app_vhost }}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/{{ app_vhost }}/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1d;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{%- endif %}

        location / {
            # Resolved at request time so Nginx starts even if the app is down.
            set $upstream_app http://{{ app_container }}:{{ app_port }};
            proxy_pass $upstream_app;
            proxy_http_version 1.1;

            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto {{ 'https' if enable_tls else '$scheme' }};
            proxy_set_header X-Forwarded-Host  $host;

            proxy_cache_bypass $http_upgrade;
            proxy_read_timeout 60s;
        }

        # Immutable build assets - let the browser cache them hard.
        location /_next/static/ {
            set $upstream_static http://{{ app_container }}:{{ app_port }};
            proxy_pass $upstream_static;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }
{% endfor %}}

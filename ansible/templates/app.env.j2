# Managed by Ansible - rendered from GitHub Actions secrets on every deploy.
# Mode 0600, root-owned. Read by the app container via `env_file`.
NODE_ENV=production
PORT={{ app_port }}
HOSTNAME=0.0.0.0

# --- Auth.js (next-auth v5) --------------------------------------------------
AUTH_SECRET={{ auth_secret }}
AUTH_URL={{ auth_url | default((enable_tls | ternary('https', 'http')) ~ '://' ~ app_vhost) }}
AUTH_TRUST_HOST=true
AUTH_SESSION_MAX_AGE_SECONDS={{ auth_session_max_age_seconds | default(2592000) }}
{% if nextauth_secret | default('') | length > 0 %}
# src/libs/auth.config.ts reads NEXTAUTH_SECRET *before* AUTH_SECRET, so setting
# it here overrides the value above. Only pass it to match an existing Vercel
# deployment's session cookies; otherwise leave it unset.
NEXTAUTH_SECRET={{ nextauth_secret }}
{% endif %}

# --- MongoDB -----------------------------------------------------------------
MONGODB_URI={{ mongodb_uri }}
MONGODB_DEBUG={{ mongodb_debug | default(0) }}
{% if mongodb_dns_servers | default('') | length > 0 %}
# Overrides the container's resolver for the mongodb+srv SRV lookup.
MONGODB_DNS_SERVERS={{ mongodb_dns_servers }}
{% endif %}

# --- Response obfuscation ----------------------------------------------------
# Must agree with the NEXT_PUBLIC_ENABLE_OBFUSCATION value baked at build time.
ENABLE_OBFUSCATION={{ enable_obfuscation | default(0) }}
OBFUSCATION_SECRET={{ obfuscation_secret | default('') }}
NEXT_PUBLIC_ENABLE_OBFUSCATION={{ ((enable_obfuscation | default(0) | string | lower) in ['1', 'true']) | string | lower }}

# --- Cloudinary --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME={{ cloudinary_cloud_name | default('') }}
CLOUDINARY_API_KEY={{ cloudinary_api_key | default('') }}
CLOUDINARY_API_SECRET={{ cloudinary_api_secret | default('') }}

# --- App ---------------------------------------------------------------------
SALON_TIMEZONE={{ salon_timezone | default('America/New_York') }}
ENABLE_API_DOCS={{ enable_api_docs | default(0) }}
